[Unit]
Description=OpenQuest API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/openquest/current
EnvironmentFile=/etc/openquest.env
Environment=NODE_ENV=production
Environment=HOME=/srv/openquest/data
Environment=PATH=/opt/secondspin-node/bin:/usr/bin:/bin
ExecStart=/srv/openquest/current/node_modules/.bin/tsx src/server/index.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/openquest

[Install]
WantedBy=multi-user.target
